[Unit]
Description=Mini SOC Detection Loop
Documentation=file:@APP_DIR@/README.md
After=network-online.target postgresql.service soc-backend.service
Wants=postgresql.service soc-backend.service

[Service]
Type=simple
User=@SOC_USER@
Group=@SOC_USER@
StateDirectory=mini-soc
StateDirectoryMode=0750
WorkingDirectory=@APP_DIR@
EnvironmentFile=@ENV_FILE@
ExecStart=@VENV_DIR@/bin/python -m detection.run
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
UMask=0027
ReadWritePaths=/var/lib/mini-soc
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
