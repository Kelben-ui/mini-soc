# Legacy loop (detection/run.py). Production uses mini-soc-worker.service
# (detection/worker.py); do NOT enable both or alerts get processed twice.
[Unit]
Description=Mini SOC Detection Engine (loop)
After=network.target postgresql.service soc-backend.service

[Service]
User=mini-soc
Group=mini-soc
WorkingDirectory=/opt/mini-soc/detection
EnvironmentFile=/etc/mini-soc/.env
ExecStart=/opt/mini-soc/.venv/bin/python run.py
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/mini-soc /var/lib/mini-soc
ReadOnlyPaths=/etc/mini-soc

[Install]
WantedBy=multi-user.target
