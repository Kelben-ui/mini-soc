[Unit]
Description=Mini SOC Backend API (FastAPI/Uvicorn)
Documentation=file:@APP_DIR@/README.md
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=@SOC_USER@
Group=@SOC_USER@
StateDirectory=mini-soc
StateDirectoryMode=0750
WorkingDirectory=@APP_DIR@
EnvironmentFile=@ENV_FILE@
ExecStart=@VENV_DIR@/bin/python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=2
# NoNewPrivileges is intentionally OFF: the backend runs the sudo-confined
# response-action helper (task 4.7) and sudo cannot escalate with that flag
# set.  The privilege is still tightly bounded - sudoers allows only
# /usr/local/sbin/soc-block (see deploy/sudoers/mini-soc-soc-block).
PrivateTmp=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
UMask=0027
ReadWritePaths=/var/lib/mini-soc
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
