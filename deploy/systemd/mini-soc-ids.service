[Unit]
Description=Mini SOC IDS/IPS
Documentation=file:@APP_DIR@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@IDS_USER@
Group=@IDS_USER@
# Reads the systemd journal (systemd-journal), /var/log/{auth,kern}.log (adm)
# and /etc/mini-soc/ids.yaml (0640 root:@SOC_USER@), so it joins @SOC_USER@ too.
# It never runs as root.
SupplementaryGroups=systemd-journal adm @SOC_USER@
# DNS sniffing (task 4.5) needs a raw socket; grant only CAP_NET_RAW, nothing
# else.  Set dns.enabled: false in ids.yaml to run without it.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
WorkingDirectory=@APP_DIR@
EnvironmentFile=@ENV_FILE@
# Unbuffered stdout/stderr: the daemon's banner and its sniffer errors have
# to reach the journal immediately, not when the 8 KiB buffer fills up.
Environment=PYTHONUNBUFFERED=1
ExecStart=@VENV_DIR@/bin/python -m ids.live_ids_ips
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
UMask=0027
ReadWritePaths=/var/log/mini_soc_ids.json
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
