[Unit]
Description=Mini SOC Log Agent
Documentation=file:@APP_DIR@/README.md
After=network-online.target soc-collector.service
Wants=soc-collector.service

[Service]
Type=simple
User=@SOC_USER@
Group=@SOC_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@ENV_FILE@
ExecStart=@VENV_DIR@/bin/python -m agents.log_agent.agent
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
UMask=0027
ReadWritePaths=/var/lib/mini-soc
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
