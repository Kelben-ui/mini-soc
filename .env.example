# Database
DATABASE_URL=postgresql://mini_soc:CHANGE_ME@localhost:5432/mini_soc

# JWT
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
JWT_EXPIRE_MINUTES=60

# API Keys
INGEST_API_KEY=CHANGE_ME_INGEST_KEY

# CORS
CORS_ORIGINS=http://YOUR_EC2_IP:80,http://YOUR_EC2_IP:443,http://localhost:5173

# Paths
EVIDENCE_DIR=/var/lib/mini-soc/evidence
RULES_DIR=/opt/mini-soc/rules
SOC_HOSTNAME=ec2-host

# URLs
COLLECTOR_URL=http://127.0.0.1:9000
BACKEND_URL=http://127.0.0.1:8000

# Detection
DETECTION_INTERVAL_SECONDS=5

# IDS
IDS_OUTPUT=/var/log/mini_soc_ids.json
IDS_CONFIG=/etc/mini-soc/ids.yaml
IDS_PREFIX_SOC_DROP=SOC_DROP:
IDS_PREFIX_SOC_OUT=SOC_OUT:
IDS_SCAN_WINDOW_SEC=60
IDS_SCAN_THRESHOLD=15
IDS_OUTBOUND_ALLOW=53,80,443,123
IDS_DNS_MAX_LABEL=50
IDS_DNS_RATE_PER_MIN=100
