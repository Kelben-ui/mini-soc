# Mini SOC runtime configuration.
#
# This is the single file that drives every service. On EC2 it lives at
# /etc/mini-soc/.env (mode 0640, root:mini-soc) and is injected into the
# systemd units via EnvironmentFile=. For local development the repo copies
# it to .env and python-dotenv loads it automatically.
#
# Copy to /etc/mini-soc/.env and replace every CHANGE_ME value.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://mini_soc:CHANGE_ME@localhost:5432/mini_soc

# --- Auth -------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
JWT_EXPIRE_MINUTES=60

# --- Ingest API key (collector -> backend) ----------------------------------
INGEST_API_KEY=CHANGE_ME_INGEST_KEY

# --- CORS (comma-separated origins allowed to call the API) -----------------
CORS_ORIGINS=https://ec2-host,http://localhost:5173,http://127.0.0.1:5173

# --- Paths ------------------------------------------------------------------
# Repo checkout / venv live under this directory (see deploy/install.sh).
APP_DIR=/home/ubuntu/mini-soc
VAR_DIR=/var/lib/mini-soc
EVIDENCE_DIR=/var/lib/mini-soc/evidence
RULES_DIR=/home/ubuntu/mini-soc/rules
AGENT_SPOOL_DIR=/var/lib/mini-soc/agent/spool

# --- Identity ---------------------------------------------------------------
# SOC_HOSTNAME is the collector instance hostname written on every event.
# SOC_PRIVATE_IP is the instance private IP (dst_ip for local traffic).
SOC_HOSTNAME=ec2-host
SOC_PRIVATE_IP=172.31.13.199

# --- Service URLs -----------------------------------------------------------
COLLECTOR_URL=http://127.0.0.1:9000
COLLECTOR_INGEST_URL=http://127.0.0.1:9000/ingest
BACKEND_URL=http://127.0.0.1:8000

# --- Detection --------------------------------------------------------------
DETECTION_INTERVAL_SECONDS=5
DETECTION_POLL_SECONDS=2
DETECTION_RULES_DIR=/home/ubuntu/mini-soc/rules

# --- IDS/IPS ----------------------------------------------------------------
IDS_OUTPUT=/var/log/mini_soc_ids.json
IDS_CONFIG=/etc/mini-soc/ids.yaml
IDS_ALLOWLIST=
IDS_PREFIX_SOC_DROP=SOC_DROP:
IDS_PREFIX_SOC_OUT=SOC_OUT:
IDS_SCAN_WINDOW_SEC=60
IDS_SCAN_THRESHOLD=15
IDS_SSH_WINDOW_SEC=300
IDS_SSH_THRESHOLD=10
IDS_COOLDOWN_SEC=60
IDS_OUTBOUND_ALLOW=53,80,443,123
IDS_DNS_MAX_LABEL=50
IDS_DNS_RATE_PER_MIN=100

# --- TLS / nginx (used by deploy/install.sh) --------------------------------
# DOMAIN is the dashboard hostname; TLS_CERT/TLS_KEY point at the certificate.
# install.sh generates a self-signed pair under /etc/ssl/mini-soc when absent.
DOMAIN=_
TLS_CERT=/etc/ssl/mini-soc/mini-soc.crt
TLS_KEY=/etc/ssl/mini-soc/mini-soc.key
